# Multi-stage production Dockerfile for Evaluador Técnico Backend (FastAPI + WeasyPrint)
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Instalar dependencias del sistema requeridas para WeasyPrint y compiladores
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    shared-mime-info \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar uv para resolución ultrarrápida y determinista de dependencias
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copiar archivos de configuración de dependencias
COPY apps/api/pyproject.toml apps/api/uv.lock* ./

# Instalar dependencias en el entorno virtual
RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    uv export --format requirements-txt --no-dev -o requirements.txt && \
    uv pip install --no-cache -r requirements.txt && \
    rm -f requirements.txt

# Etapa final de producción
FROM python:3.12-slim-bookworm AS runner

WORKDIR /app

# Instalar dependencias runtime para renderizado WeasyPrint y fuentes
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    shared-mime-info \
    fonts-dejavu-core \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar entorno virtual precompilado
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Crear usuario no privilegiado por seguridad
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --gid 1001 appuser

# Copiar código fuente del backend y problemas
COPY apps/api/src ./src
COPY apps/api/alembic.ini ./alembic.ini
COPY apps/api/alembic ./alembic
COPY problems ./problems

# Copiar script de entrypoint y asignar permisos de ejecución
COPY infra/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
