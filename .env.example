# LLM Gateway (Grok vía Proxy del Reto)
LLM_BASE_URL=https://api.reto.pltk.mx/v1
LLM_MODEL=grok-4.6
LLM_API_KEY=tu_llave_del_reto_aqui
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://evaluador:evaluador_password_dev@localhost:5435/evaluador_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Judge0 CE (Sandbox de ejecución de código)
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Seguridad y Autenticación JWT
SECRET_KEY=evaluador_secret_jwt_key_super_segura_2026
ENVIRONMENT=development
